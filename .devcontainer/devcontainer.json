{
  "name": "Gukura (Python analysis + Node web app)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["hackathon/README.md", "hackathon/web/src/App.tsx"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "dbaeumer.vscode-eslint"]
    }
  },
  "updateContentCommand": "pip3 install --user -r hackathon/analysis/requirements.txt && npm --prefix hackathon/web ci",
  "postAttachCommand": {
    "web": "npm --prefix hackathon/web run dev -- --host"
  },
  "portsAttributes": {
    "5173": { "label": "Gukura", "onAutoForward": "openPreview" }
  },
  "forwardPorts": [5173]
}
